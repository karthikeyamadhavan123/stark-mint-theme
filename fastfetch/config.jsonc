{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": {
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;179;39;45"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;179;39;45m█ █\u001b[0m \u001b[38;2;214;168;78m█\u001b[0m  \u001b[38;2;214;168;78;1mSYSTEM\u001b[0m \u001b[38;2;214;168;78m───────────────────────────────────\u001b[0m"
        },
        "break",
        {
            "type": "os",
            "key": "  󰍹  OS:"
        },
        {
            "type": "host",
            "key": "  󰌢  Host:"
        },
        {
            "type": "kernel",
            "key": "  ⚙  Kernel:"
        },
        {
            "type": "uptime",
            "key": "  󰅐  Uptime:"
        },
        {
            "type": "packages",
            "key": "  󰏖  Packages:"
        },
        {
            "type": "shell",
            "key": "  ❯  Shell:"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;179;39;45m█ █\u001b[0m \u001b[38;2;214;168;78m█\u001b[0m  \u001b[38;2;214;168;78;1mHARDWARE\u001b[0m \u001b[38;2;214;168;78m─────────────────────────────────\u001b[0m"
        },
        "break",
        {
            "type": "cpu",
            "key": "  󰍛  CPU:"
        },
        {
            "type": "gpu",
            "key": "  󰢮  GPU:"
        },
        {
            "type": "memory",
            "key": "  󰍛  Memory:"
        },
        {
            "type": "swap",
            "key": "  󰓡  Swap:"
        },
        {
            "type": "disk",
            "key": "  󰋊  Disk:"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;214;168;78m────────────────────────────────────────────────────\u001b[0m"
        },
        {
            "type": "custom",
            "format": "                                       \u001b[38;2;85;221;224m● System Online\u001b[0m"
        },
        "break"
    ]
}
